
// =====================================================================
// EVAPOTRANSPIRATION AND CROP WATER STRESS MONITORING
// PAKISTAN | MODIS | 2001-2024
//
// ET | PET | CWSI | CROPLAND | HIGH STRESS | TRENDS
//
// OUTPUT:
// 5 CSV EXPORTS 
// 9 IMAGE EXPORTS
//
// OPTIMIZATION:
// 1. Server-side image stacking using ee.List.iterate()
// 2. Annual statistics use stacked images
// 3. Monthly statistics processed in 12-month batches
// 4. No reduceRegion() inside a mapped monthly FeatureCollection
// =====================================================================


// =====================================================================
// 1. STUDY AREA AND SETTINGS
// =====================================================================

var roiBasin = ee.FeatureCollection(
  'projects/ee-imranak32/assets/Pak_FULL'
);

var roi = roiBasin.geometry();

Map.centerObject(roiBasin, 5);

Map.addLayer(
  roiBasin,
  {color: 'black'},
  'Pakistan Study Area',
  false
);

var firstYear = 2001;
var lastYear = 2024;

var startDate = '2001-01-01';
var endDate = '2025-01-01';

var threshold = 0.8;
var cropClass = 12;

var exportScale = 500;
var exportMaxPixels = 1e13;
var exportTileScale = 8;

var exportFolder = 'evapotranspiration_analysis';

var yearList = ee.List.sequence(firstYear, lastYear);

var exportRegion = roi;


// =====================================================================
// 2. IMAGE STACKING FUNCTION
// =====================================================================

function stackImages(imageList) {

  imageList = ee.List(imageList);

  var firstImage = ee.Image(imageList.get(0));

  var stacked = ee.Image(
    imageList.slice(1).iterate(function(image, previous) {

      return ee.Image(previous).addBands(
        ee.Image(image)
      );

    }, firstImage)
  );

  return stacked;
}


// =====================================================================
// 3. LOAD MODIS ET/PET DATA
// =====================================================================

var modisEtCollection = ee.ImageCollection(
  'MODIS/061/MOD16A2GF'
)
.filterDate(startDate, endDate)
.select(['ET', 'PET']);


// Apply MODIS scale factor: 0.1

var etCollection = modisEtCollection.map(function(image) {

  return image.select('ET')
    .multiply(0.1)
    .rename('ET')
    .toFloat()
    .copyProperties(image, ['system:time_start']);

});


var petCollection = modisEtCollection.map(function(image) {

  return image.select('PET')
    .multiply(0.1)
    .rename('PET')
    .toFloat()
    .copyProperties(image, ['system:time_start']);

});


// Calculate CWSI for each MODIS composite.
//
// CWSI = 1 - (ET / PET)
// PET must be greater than zero.

var cwsiCollection = modisEtCollection.map(function(image) {

  var et = image.select('ET').multiply(0.1);
  var pet = image.select('PET').multiply(0.1);

  var cwsi = ee.Image.constant(1)
    .subtract(et.divide(pet))
    .clamp(0, 1)
    .updateMask(pet.gt(0))
    .rename('CWSI')
    .toFloat();

  return cwsi.copyProperties(
    image,
    ['system:time_start']
  );

});


// =====================================================================
// 4. LONG-TERM MEAN ET, PET AND CWSI
// =====================================================================

var meanEt = etCollection.mean()
  .rename('ET')
  .toFloat();

var meanPET = petCollection.mean()
  .rename('PET')
  .toFloat();

var meanCWSI = cwsiCollection.mean()
  .rename('CWSI')
  .toFloat();


// Summer ET: June-August, all years.

var summerET = etCollection
  .filter(ee.Filter.calendarRange(6, 8, 'month'))
  .mean()
  .rename('Summer_ET')
  .toFloat();


// =====================================================================
// 5. LAND COVER AND CROPLAND
// MCD12Q1 IGBP CLASS 12 = CROPLANDS
// =====================================================================

var landCoverCollection = ee.ImageCollection(
  'MODIS/061/MCD12Q1'
)
.filterDate(startDate, endDate)
.select('LC_Type1');


// Long-term dominant land cover.

var longTermLandCover = landCoverCollection
  .mode()
  .rename('LC_Type1');


// Cropland mask.

var cropArea = longTermLandCover
  .eq(cropClass)
  .rename('Cropland');


// Long-term cropland CWSI.

var cwsiForCrops = meanCWSI
  .updateMask(cropArea)
  .rename('Crop_CWSI');


// Long-term high-stress cropland.

var highStressCWSI = cwsiForCrops
  .updateMask(cwsiForCrops.gt(threshold))
  .rename('HighStress_CWSI');


// =====================================================================
// 6. MAP VISUALIZATION
// =====================================================================

Map.addLayer(
  meanEt.clip(roi),
  {
    min: 0,
    max: 15,
    palette: ['blue', 'cyan', 'green', 'yellow', 'red']
  },
  'Mean ET 2001-2024',
  false
);

Map.addLayer(
  meanPET.clip(roi),
  {
    min: 0,
    max: 70,
    palette: ['white', 'blue', 'green', 'yellow', 'red']
  },
  'Mean PET 2001-2024',
  false
);

Map.addLayer(
  summerET.clip(roi),
  {
    min: 0,
    max: 20,
    palette: ['blue', 'cyan', 'green', 'yellow', 'red']
  },
  'Summer ET June-August',
  false
);

Map.addLayer(
  meanCWSI.clip(roi),
  {
    min: 0,
    max: 1,
    palette: ['green', 'yellow', 'orange', 'red']
  },
  'Mean CWSI',
  true
);

Map.addLayer(
  cropArea.selfMask().clip(roi),
  {
    palette: ['green']
  },
  'Cropland IGBP Class 12',
  false
);

Map.addLayer(
  cwsiForCrops.clip(roi),
  {
    min: 0,
    max: 1,
    palette: ['green', 'yellow', 'orange', 'red']
  },
  'Cropland CWSI',
  false
);

Map.addLayer(
  highStressCWSI.clip(roi),
  {
    min: 0.8,
    max: 1,
    palette: ['yellow', 'red']
  },
  'High Stress CWSI > 0.8',
  false
);


// =====================================================================
// 7. TEMPORAL TREND ANALYSIS
// Linear regression using MODIS composite observations
// =====================================================================

var startTime = ee.Date(startDate);

function addTimeBand(image, bandName) {

  var time = ee.Date(
    image.get('system:time_start')
  ).difference(startTime, 'year');

  var timeBand = ee.Image.constant(time)
    .rename('time')
    .toFloat();

  return image
    .addBands(timeBand)
    .select(['time', bandName]);
}


// ET trend.

var etTrendCollection = etCollection.map(function(image) {

  return addTimeBand(image, 'ET');

});

var etRegression = etTrendCollection
  .reduce(ee.Reducer.linearFit())
  .clip(roi);

var etSlope = etRegression
  .select('scale')
  .rename('ET_Trend');


// CWSI trend.

var cwsiTrendCollection = cwsiCollection.map(function(image) {

  return addTimeBand(image, 'CWSI');

});

var cwsiRegression = cwsiTrendCollection
  .reduce(ee.Reducer.linearFit())
  .clip(roi);

var cwsiSlope = cwsiRegression
  .select('scale')
  .rename('CWSI_Trend');


// Display trends.

Map.addLayer(
  etSlope,
  {
    min: -0.1,
    max: 0.1,
    palette: ['blue', 'white', 'red']
  },
  'ET Temporal Trend',
  false
);

Map.addLayer(
  cwsiSlope,
  {
    min: -0.02,
    max: 0.02,
    palette: ['blue', 'white', 'red']
  },
  'CWSI Temporal Trend',
  false
);


// =====================================================================
// 8. IMAGE EXPORTS
// TOTAL = 9 IMAGE EXPORTS
// =====================================================================


// 1. Mean ET

Export.image.toDrive({
  image: meanEt.clip(roi),
  description: 'Mean_ET_2001_2024',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 2. Mean PET

Export.image.toDrive({
  image: meanPET.clip(roi),
  description: 'Mean_PET_2001_2024',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 3. Summer ET

Export.image.toDrive({
  image: summerET.clip(roi),
  description: 'Summer_ET_2001_2024',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 4. Mean CWSI

Export.image.toDrive({
  image: meanCWSI.clip(roi),
  description: 'Mean_CWSI_2001_2024',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 5. Cropland mask

Export.image.toDrive({
  image: cropArea.selfMask().clip(roi),
  description: 'MODIS_Cropland_Mask',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 6. Cropland CWSI

Export.image.toDrive({
  image: cwsiForCrops.clip(roi),
  description: 'CWSI_Croplands_Only',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 7. High-stress cropland

Export.image.toDrive({
  image: highStressCWSI.clip(roi),
  description: 'High_Stress_Crops_CWSI_gt_0_8',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 8. ET trend

Export.image.toDrive({
  image: etSlope,
  description: 'ET_Trend_2001_2024',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// 9. CWSI trend

Export.image.toDrive({
  image: cwsiSlope,
  description: 'CWSI_Trend_2001_2024',
  folder: exportFolder,
  region: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels
});


// =====================================================================
// 9. COMBINED STATISTICAL REDUCER
// =====================================================================

var statisticalReducer = ee.Reducer.mean()
  .combine({
    reducer2: ee.Reducer.minMax(),
    sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.stdDev(),
    sharedInputs: true
  });


// =====================================================================
// 10. ANNUAL ET, PET AND CWSI STATISTICS
// 24 YEARS
// ONE STACKED REGIONAL REDUCTION
// =====================================================================

var annualImages = yearList.map(function(year) {

  year = ee.Number(year);

  var start = ee.Date.fromYMD(year, 1, 1);
  var end = start.advance(1, 'year');

  var annualCollection = modisEtCollection
    .filterDate(start, end);

  var annualET = annualCollection
    .select('ET')
    .mean()
    .multiply(0.1)
    .rename('ET');

  var annualPET = annualCollection
    .select('PET')
    .mean()
    .multiply(0.1)
    .rename('PET');

  var annualCWSI = cwsiCollection
    .filterDate(start, end)
    .mean()
    .rename('CWSI');

  var yearText = year.format('%04d');

  var names = ee.List([
    ee.String('ET_').cat(yearText),
    ee.String('PET_').cat(yearText),
    ee.String('CWSI_').cat(yearText)
  ]);

  return ee.Image.cat([
    annualET,
    annualPET,
    annualCWSI
  ])
  .rename(names)
  .toFloat();

});


// Correct server-side stacking.

var annualStack = stackImages(annualImages);


// One regional reduction.

var annualDictionary = annualStack.reduceRegion({
  reducer: statisticalReducer,
  geometry: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels,
  tileScale: exportTileScale
});


// Reconstruct 24 annual records.

var annualStatistics = ee.FeatureCollection(
  yearList.map(function(year) {

    year = ee.Number(year);

    var y = year.format('%04d');

    var etBand = ee.String('ET_').cat(y);
    var petBand = ee.String('PET_').cat(y);
    var cwsiBand = ee.String('CWSI_').cat(y);

    var properties = ee.Dictionary({

      Year: year,

      ET_mean: annualDictionary.get(
        etBand.cat('_mean')
      ),

      ET_min: annualDictionary.get(
        etBand.cat('_min')
      ),

      ET_max: annualDictionary.get(
        etBand.cat('_max')
      ),

      ET_stdDev: annualDictionary.get(
        etBand.cat('_stdDev')
      ),

      PET_mean: annualDictionary.get(
        petBand.cat('_mean')
      ),

      PET_min: annualDictionary.get(
        petBand.cat('_min')
      ),

      PET_max: annualDictionary.get(
        petBand.cat('_max')
      ),

      PET_stdDev: annualDictionary.get(
        petBand.cat('_stdDev')
      ),

      CWSI_mean: annualDictionary.get(
        cwsiBand.cat('_mean')
      ),

      CWSI_min: annualDictionary.get(
        cwsiBand.cat('_min')
      ),

      CWSI_max: annualDictionary.get(
        cwsiBand.cat('_max')
      ),

      CWSI_stdDev: annualDictionary.get(
        cwsiBand.cat('_stdDev')
      )

    });

    return ee.Feature(null, properties);

  })
);


// CSV 1.

Export.table.toDrive({
  collection: annualStatistics,
  description: 'Annual_ET_PET_CWSI_Statistics_2001_2024',
  fileNamePrefix: 'Annual_ET_PET_CWSI_Statistics_2001_2024',
  folder: exportFolder,
  fileFormat: 'CSV'
});


// =====================================================================
// 11. ANNUAL CROPLAND CWSI STATISTICS
// 24 YEARS
// ONE STACKED REGIONAL REDUCTION
// =====================================================================

var annualCropImages = yearList.map(function(year) {

  year = ee.Number(year);

  var start = ee.Date.fromYMD(year, 1, 1);
  var end = start.advance(1, 'year');

  var annualCWSI = cwsiCollection
    .filterDate(start, end)
    .mean();

  var annualLandCover = ee.Image(
    landCoverCollection
      .filterDate(start, end)
      .first()
  );

  var annualCropMask = annualLandCover.eq(cropClass);

  var cropCWSI = annualCWSI
    .updateMask(annualCropMask);

  var bandName = ee.String('CropCWSI_')
    .cat(year.format('%04d'));

  return cropCWSI.rename(bandName).toFloat();

});


// Stack annual cropland images.

var annualCropStack = stackImages(annualCropImages);


// One regional reduction.

var annualCropDictionary = annualCropStack.reduceRegion({
  reducer: statisticalReducer,
  geometry: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels,
  tileScale: exportTileScale
});


// Reconstruct annual records.

var annualCropStatistics = ee.FeatureCollection(
  yearList.map(function(year) {

    year = ee.Number(year);

    var band = ee.String('CropCWSI_')
      .cat(year.format('%04d'));

    var properties = ee.Dictionary({

      Year: year,

      Cropland_IGBP_Class: cropClass,

      Crop_CWSI_mean: annualCropDictionary.get(
        band.cat('_mean')
      ),

      Crop_CWSI_min: annualCropDictionary.get(
        band.cat('_min')
      ),

      Crop_CWSI_max: annualCropDictionary.get(
        band.cat('_max')
      ),

      Crop_CWSI_stdDev: annualCropDictionary.get(
        band.cat('_stdDev')
      )

    });

    return ee.Feature(null, properties);

  })
);


// CSV 2.

Export.table.toDrive({
  collection: annualCropStatistics,
  description: 'Annual_Cropland_CWSI_Statistics_2001_2024',
  fileNamePrefix: 'Annual_Cropland_CWSI_Statistics_2001_2024',
  folder: exportFolder,
  fileFormat: 'CSV'
});


// =====================================================================
// 12. ANNUAL HIGH-STRESS CROPLAND STATISTICS
// THRESHOLD > 0.8
// ONE STACKED REGIONAL REDUCTION
// =====================================================================

var annualHighStressImages = yearList.map(function(year) {

  year = ee.Number(year);

  var start = ee.Date.fromYMD(year, 1, 1);
  var end = start.advance(1, 'year');

  var annualCWSI = cwsiCollection
    .filterDate(start, end)
    .mean();

  var annualLandCover = ee.Image(
    landCoverCollection
      .filterDate(start, end)
      .first()
  );

  var cropMask = annualLandCover.eq(cropClass);

  var cropCWSI = annualCWSI
    .updateMask(cropMask);

  var highStress = cropCWSI
    .updateMask(cropCWSI.gt(threshold));

  var bandName = ee.String('HighStress_')
    .cat(year.format('%04d'));

  return highStress.rename(bandName).toFloat();

});


// Stack high-stress images.

var annualHighStressStack = stackImages(
  annualHighStressImages
);


// One regional reduction.

var highStressDictionary = annualHighStressStack.reduceRegion({
  reducer: statisticalReducer,
  geometry: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels,
  tileScale: exportTileScale
});


// Reconstruct annual records.

var annualHighStressStatistics = ee.FeatureCollection(
  yearList.map(function(year) {

    year = ee.Number(year);

    var band = ee.String('HighStress_')
      .cat(year.format('%04d'));

    var properties = ee.Dictionary({

      Year: year,

      High_Stress_Threshold: threshold,

      HighStress_CWSI_mean: highStressDictionary.get(
        band.cat('_mean')
      ),

      HighStress_CWSI_min: highStressDictionary.get(
        band.cat('_min')
      ),

      HighStress_CWSI_max: highStressDictionary.get(
        band.cat('_max')
      ),

      HighStress_CWSI_stdDev: highStressDictionary.get(
        band.cat('_stdDev')
      )

    });

    return ee.Feature(null, properties);

  })
);


// CSV 3.

Export.table.toDrive({
  collection: annualHighStressStatistics,
  description: 'Annual_HighStress_CWSI_Statistics_2001_2024',
  fileNamePrefix: 'Annual_HighStress_CWSI_Statistics_2001_2024',
  folder: exportFolder,
  fileFormat: 'CSV'
});


// =====================================================================
// 13. ANNUAL CROPLAND AND HIGH-STRESS AREA
// UNIT = km2
// ONE STACKED REGIONAL REDUCTION
// =====================================================================

var pixelArea = ee.Image.pixelArea()
  .divide(1e6)
  .toFloat()
  .clip(roi);


// Create annual area images.

var annualAreaImages = yearList.map(function(year) {

  year = ee.Number(year);

  var start = ee.Date.fromYMD(year, 1, 1);
  var end = start.advance(1, 'year');

  var annualCWSI = cwsiCollection
    .filterDate(start, end)
    .mean();

  var annualLandCover = ee.Image(
    landCoverCollection
      .filterDate(start, end)
      .first()
  );

  var cropMask = annualLandCover.eq(cropClass);

  var validCropMask = cropMask.and(
    annualCWSI.mask().gt(0)
  );

  var highStressMask = validCropMask.and(
    annualCWSI.gt(threshold)
  );

  var y = year.format('%04d');


  var cropAreaImage = pixelArea
    .updateMask(cropMask)
    .unmask(0)
    .rename(
      ee.String('CropArea_').cat(y)
    );

  var validCropAreaImage = pixelArea
    .updateMask(validCropMask)
    .unmask(0)
    .rename(
      ee.String('ValidCropArea_').cat(y)
    );

  var highStressAreaImage = pixelArea
    .updateMask(highStressMask)
    .unmask(0)
    .rename(
      ee.String('HighStressArea_').cat(y)
    );

  return ee.Image.cat([
    cropAreaImage,
    validCropAreaImage,
    highStressAreaImage
  ]);

});


// Stack annual area images.

var annualAreaStack = stackImages(annualAreaImages);


// One regional sum reduction.

var annualAreaDictionary = annualAreaStack.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: exportRegion,
  scale: exportScale,
  maxPixels: exportMaxPixels,
  tileScale: exportTileScale
});


// Reconstruct annual area records.

var annualAreaStatistics = ee.FeatureCollection(
  yearList.map(function(year) {

    year = ee.Number(year);

    var y = year.format('%04d');

    var cropAreaValue = ee.Number(
      annualAreaDictionary.get(
        ee.String('CropArea_').cat(y).cat('_sum'),
        0
      )
    );

    var validAreaValue = ee.Number(
      annualAreaDictionary.get(
        ee.String('ValidCropArea_').cat(y).cat('_sum'),
        0
      )
    );

    var highStressValue = ee.Number(
      annualAreaDictionary.get(
        ee.String('HighStressArea_').cat(y).cat('_sum'),
        0
      )
    );

    var percentage = ee.Algorithms.If(
      validAreaValue.gt(0),
      highStressValue.divide(validAreaValue).multiply(100),
      0
    );

    return ee.Feature(null, {

      Year: year,

      Cropland_Area_km2: cropAreaValue,

      Valid_Cropland_Area_km2: validAreaValue,

      HighStress_Area_km2: highStressValue,

      HighStress_Cropland_Percent: percentage,

      CWSI_Threshold: threshold

    });

  })
);


// CSV 4.

Export.table.toDrive({
  collection: annualAreaStatistics,
  description: 'Annual_Cropland_HighStress_Area_2001_2024',
  fileNamePrefix: 'Annual_Cropland_HighStress_Area_2001_2024',
  folder: exportFolder,
  fileFormat: 'CSV'
});


// =====================================================================
// 14. MONTHLY ET, PET AND CWSI STATISTICS
// 288 MONTHS
//
// MEMORY OPTIMIZATION:
// Process one calendar year (12 months) at a time.
// Each annual batch contains 36 bands.
// A single 864-band stack is avoided.
//
// 24 annual batches are combined into one CSV export.
// =====================================================================


// Empty list to collect all 288 monthly records.

var monthlyRecordList = ee.List([]);


// Sequentially process 24 calendar years.

var monthlyRecordListFinal = ee.List(
  yearList.iterate(function(year, previousRecords) {

    year = ee.Number(year);

    var yearStart = ee.Date.fromYMD(year, 1, 1);


    // Create 12 monthly images for this year.

    var monthlyImagesThisYear = ee.List.sequence(0, 11)
      .map(function(monthOffset) {

        monthOffset = ee.Number(monthOffset);

        var monthStart = yearStart.advance(
          monthOffset,
          'month'
        );

        var monthEnd = monthStart.advance(1, 'month');

        var monthlyCollection = modisEtCollection
          .filterDate(monthStart, monthEnd);


        var monthlyET = monthlyCollection
          .select('ET')
          .mean()
          .multiply(0.1)
          .rename('ET');

        var monthlyPET = monthlyCollection
          .select('PET')
          .mean()
          .multiply(0.1)
          .rename('PET');

        var monthlyCWSI = cwsiCollection
          .filterDate(monthStart, monthEnd)
          .mean()
          .rename('CWSI');


        var dateText = monthStart.format('YYYY_MM');

        var bandNames = ee.List([
          ee.String('ET_').cat(dateText),
          ee.String('PET_').cat(dateText),
          ee.String('CWSI_').cat(dateText)
        ]);

        return ee.Image.cat([
          monthlyET,
          monthlyPET,
          monthlyCWSI
        ])
        .rename(bandNames)
        .toFloat();

      });


    // Stack the 12 months (36 bands).

    var monthlyYearStack = stackImages(
      monthlyImagesThisYear
    );


    // One regional reduction for this calendar year.

    var monthlyYearDictionary = monthlyYearStack.reduceRegion({
      reducer: statisticalReducer,
      geometry: exportRegion,
      scale: exportScale,
      maxPixels: exportMaxPixels,
      tileScale: exportTileScale
    });


    // Reconstruct the 12 monthly records.

    var monthlyYearRecords = ee.List.sequence(0, 11)
      .map(function(monthOffset) {

        monthOffset = ee.Number(monthOffset);

        var monthStart = yearStart.advance(
          monthOffset,
          'month'
        );

        var dateText = monthStart.format('YYYY_MM');

        var etBand = ee.String('ET_').cat(dateText);
        var petBand = ee.String('PET_').cat(dateText);
        var cwsiBand = ee.String('CWSI_').cat(dateText);


        var properties = ee.Dictionary({

          Year: year,

          Month: monthStart.get('month'),

          Date: monthStart.format('YYYY-MM'),

          ET_mean: monthlyYearDictionary.get(
            etBand.cat('_mean')
          ),

          ET_min: monthlyYearDictionary.get(
            etBand.cat('_min')
          ),

          ET_max: monthlyYearDictionary.get(
            etBand.cat('_max')
          ),

